# Data
/data
# /reports contents are ignored except the small results-audit artifacts re-included
# lower down (search "results-audit dashboard"); excluding only /reports/* (not the dir
# itself) is required so those negations can take effect.
/reports/*

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

## https://github.com/github/gitignore/blob/4488915eec0b3a45b5c63ead28f286819c0917de/Python.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# MkDocs documentation
docs/site/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/#use-with-ide
.pdm.toml

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

outputs/
results/
multirun/
# reports/: local experiment outputs are not tracked, EXCEPT the small artifacts that
# source the results-audit dashboard (so every rendered number traces to a tracked file).
# The heavy per-realization parquet dumps stay ignored.
reports/*
!reports/runs/
!reports/baselines/
!reports/perturbation/
!reports/moment/
reports/perturbation/*/*.parquet
notebooks/000-Playground.ipynb
mlruns/
mlartifacts/
/models/
/build/
# NOTE: /docs/ is intentionally NOT ignored — it hosts the results-audit
# GitHub-Pages dashboard (docs/index.html, generated by docs/build_pages.py).
docs/__pycache__/
docs/standalone.html
.vscode/launch.json
.vscode/settings.json
renaming.py
notebooks/100-Plot-Creator.ipynb
hpc_logs/

/wandb/

# CI-local git config (deploy-token auth; never committed)
.gitconfig.ci



# Editor config
.vscode/
# Internal peer-review-confidential working notes (durable knowledge lives in docs/internal/agent/)
/agent/
# Transient paper-build logs + aggregator scratch (regenerated; not dashboard inputs)
reports/runs/*_compile_results.txt
reports/runs/*_candidate.txt

# Guard: the baselines runner writes to a configurable output base dir (default ./reports).
# Running it from inside the package once committed stale outputs under src/; never again.
src/**/reports/
